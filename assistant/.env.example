# Copy this file to `assistant/.env` and fill in your key:
#
#   cp assistant/.env.example assistant/.env
#
# Get a free API key from Google AI Studio (no Google Cloud project needed):
#   https://aistudio.google.com/apikey

# Use the Gemini API directly instead of Vertex AI. This is what lets the
# project run locally WITHOUT a Google Cloud project. Keep it FALSE.
GOOGLE_GENAI_USE_VERTEXAI=FALSE

# Your Google AI Studio API key.
GOOGLE_API_KEY=paste-your-key-here

# Optional: override the model. Defaults to gemini-2.5-flash in agent.py.
# Other options: gemini-2.5-pro, gemini-2.0-flash
# GEMINI_MODEL=gemini-2.5-flash

# Copy this file to `assistant/.env` and choose a provider and model:
#
#   cp assistant/.env.example assistant/.env
#
# API keys should stay in macOS Keychain and be injected by nono. Do not put a
# real provider key in this file.

# Supported values: gemini, openai, anthropic.
AGENT_PROVIDER=gemini

# Optional. Defaults by provider:
#   gemini:    gemini-2.5-flash
#   openai:    gpt-5.4-mini
#   anthropic: claude-sonnet-5
# AGENT_MODEL=gemini-2.5-flash

# Use the Gemini API directly instead of Vertex AI. This is what lets the
# project run locally WITHOUT a Google Cloud project. Keep it FALSE.
GOOGLE_GENAI_USE_VERTEXAI=FALSE

# nono injects exactly one of GOOGLE_API_KEY, OPENAI_API_KEY, or
# ANTHROPIC_API_KEY when the matching --credential option is used.
